rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function memberConsented(familyId, uid) {
      let member = get(/databases/$(database)/documents/families/$(familyId)/members/$(uid)).data;
      return member.consentGiven == true;
    }

    // A signed-in user joining via invite code needs to add themself to
    // memberUids before a members/{uid} doc exists, so isFamilyMember()
    // can't be used here — only allow this one-field, self-add change.
    function isJoiningSelf() {
      return isSignedIn() &&
        !(request.auth.uid in resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids"]);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /families/{familyId} {
      // Invite-code lookup needs an unauthenticated-by-membership read of the
      // family doc; this is intentionally narrow — it can't read members,
      // locations, or events, and the invite code itself is a 6-char secret.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamilyMember(familyId) || isJoiningSelf();

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }

      match /locations/{uid} {
        // A member's live location is only readable by other family members
        // if that member has consented and isn't currently paused.
        allow read: if isFamilyMember(familyId) && memberConsented(familyId, uid);
        allow write: if isSignedIn() && request.auth.uid == uid && isFamilyMember(familyId);
      }

      match /places/{placeId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      match /events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
