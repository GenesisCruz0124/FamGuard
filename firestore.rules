rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(familyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/families/$(familyId)).data.createdBy == request.auth.uid;
    }

    function isFamilyMember(familyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function memberConsented(familyId, uid) {
      let member = get(/databases/$(database)/documents/families/$(familyId)/members/$(uid)).data;
      return member.consentGiven == true;
    }

    // A signed-in user joining via invite code needs to add themself to
    // memberUids before a members/{uid} doc exists, so isFamilyMember()
    // can't be used here — only allow this one-field, self-add change.
    function isJoiningSelf() {
      return isSignedIn() &&
        !(request.auth.uid in resource.data.memberUids) &&
        request.auth.uid in request.resource.data.memberUids &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids"]);
    }

    // A code starts unclaimed (deviceId == null); the first device to
    // claim it locks it permanently to that device. Re-claims by the SAME
    // device (e.g. reinstall, re-login) are still allowed.
    function isUnclaimedOrOwnDevice(codeId) {
      let code = get(/databases/$(database)/documents/activationCodes/$(codeId)).data;
      return code.deviceId == null || code.deviceId == request.resource.data.deviceId;
    }

    // Only these two developer accounts may mint new activation codes via
    // the standalone generator tool (tools/activation-generator.html).
    function isAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email in ["genesiscruz.dev@gmail.com", "genesiscruz0124@gmail.com"];
    }

    match /users/{uid} {
      // trialStartedAt and activation.* live on this same doc; no extra
      // rules needed since they're just additional self-owned fields.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Activation codes are minted by the admin generator tool (below) or
    // manually via Firebase Console — never created by the redeeming
    // client. Reading requires already knowing the exact code string
    // (get-by-ID, not list-able), the same reasoning already used for the
    // family invite-code read above.
    match /activationCodes/{codeId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.boundUid == request.auth.uid &&
        isUnclaimedOrOwnDevice(codeId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deviceId", "boundUid", "usedAt"]);
      // Codes are created either by the admin generator tool (this rule) or
      // never otherwise — redemption only ever updates, never creates.
      allow create: if isAdminEmail() &&
        request.resource.data.deviceId == null &&
        request.resource.data.boundUid == null &&
        request.resource.data.usedAt == null;
      allow delete: if false;
    }

    match /families/{familyId} {
      // Invite-code lookup needs an unauthenticated-by-membership read of the
      // family doc; this is intentionally narrow — it can't read members,
      // locations, or events, and the invite code itself is a 6-char secret.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isFamilyMember(familyId) || isJoiningSelf();

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        allow create: if isSignedIn() && request.auth.uid == uid;
        allow update: if isSignedIn() && request.auth.uid == uid;
        allow delete: if isSignedIn() && (request.auth.uid == uid || isOwner(familyId));
      }

      match /locations/{uid} {
        // A member's live location is only readable by other family members
        // if that member has consented and isn't currently paused.
        allow read: if isFamilyMember(familyId) && memberConsented(familyId, uid);
        allow write: if isSignedIn() && request.auth.uid == uid && isFamilyMember(familyId);
        allow delete: if isSignedIn() && isOwner(familyId);
      }

      match /locationHistory/{uid}/points/{pointId} {
        allow write: if isSignedIn() && request.auth.uid == uid && isFamilyMember(familyId);
        allow read:  if isFamilyMember(familyId) && memberConsented(familyId, uid);
      }

      match /places/{placeId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isFamilyMember(familyId);
      }

      match /events/{eventId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
